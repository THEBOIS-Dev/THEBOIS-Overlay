{
  "name": "thebois-overlay",
  "version": "1.3.5",
  "description": "THEBOIS Overlay – PikaNetwork BedWars stat tracker",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "vue-tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,vue,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,html}\"",
    "typecheck": "vue-tsc --noEmit",
    "fix": "npm run lint:fix && npm run format"
  },
  "build": {
    "appId": "com.thebois.overlay",
    "productName": "THEBOIS Overlay",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "artifactName": "THEBOIS.Overlay.Setup.${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns",
      "identity": null,
      "hardenedRuntime": false
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "THEBOIS-Dev",
        "repo": "THEBOIS-Overlay",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@logdna/tail-file": "^2.2.0",
    "axios": "^1.7.7",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.3.9",
    "electron-window-state": "^5.0.3",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.1.1",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.7.4",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.5.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "electron": "^31.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "prettier": "^3.0.0",
    "semantic-release": "^25.0.3",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^2.1.6"
  }
}

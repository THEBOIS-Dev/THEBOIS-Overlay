{
  "name": "thebois-overlay",
  "version": "1.8.1",
  "description": "THEBOIS Overlay – PikaNetwork BedWars stat tracker",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "vue-tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,vue,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,html}\"",
    "typecheck": "vue-tsc --noEmit",
    "codemod": "npm --prefix codemods run codemod",
    "fix": "npm run codemod && npm run typecheck && npm run lint:fix && npm run format"
  },
  "build": {
    "appId": "com.thebois.overlay",
    "productName": "THEBOIS Overlay",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "artifactName": "THEBOIS.Overlay.Setup.${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns",
      "identity": null,
      "hardenedRuntime": false
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "THEBOIS Overlay",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "THEBOIS-Dev",
        "repo": "THEBOIS-Overlay",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@logdna/tail-file": "^4.0.2",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.1",
    "discord-rpc": "^4.0.1",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "lucide-vue-next": "^1.0.0",
    "minecraft-protocol": "^1.66.2",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.1.1",
    "prismarine-nbt": "^2.8.0",
    "radix-vue": "^1.9.9",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.61.1",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.9.2",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semantic-release": "^25.0.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.64.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  }
}
